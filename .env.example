# Copy to .env for local development values.

APP_ENV=local
SERVER_PORT=8080

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ai_workspace
POSTGRES_USER=ai_workspace
POSTGRES_PASSWORD=change_me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

OPENSEARCH_URL=http://127.0.0.1:9200
KNOWLEDGE_SEARCH_MODE=HYBRID
DOCUMENT_CHUNK_SENTENCES=5

WHISPER_PORT=9000
WHISPER_ASR_ENGINE=faster_whisper
WHISPER_ASR_MODEL=tiny

PIPER_PORT=10200
PIPER_VOICE=en_US-lessac-medium

GEMINI_API_KEY=change_me
KNOWLEDGE_EMBEDDING_PROVIDER=transformers
KNOWLEDGE_EMBEDDING_MODEL=intfloat/multilingual-e5-base
KNOWLEDGE_EMBEDDINGS_ENABLED=true
KNOWLEDGE_EMBEDDING_DIMENSIONS=768
KNOWLEDGE_EMBEDDING_BATCH_SIZE=32
KNOWLEDGE_EMBEDDING_MODEL_URI=https://huggingface.co/intfloat/multilingual-e5-base/resolve/d128750597153bb5987e10b1c3493a34e5a4502a/onnx/model.onnx
KNOWLEDGE_EMBEDDING_TOKENIZER_URI=https://huggingface.co/intfloat/multilingual-e5-base/resolve/d128750597153bb5987e10b1c3493a34e5a4502a/onnx/tokenizer.json
KNOWLEDGE_EMBEDDING_CACHE_DIRECTORY=data/models/spring-ai
# Candidates per retrieval stream, independent of the twelve answer seed chunks.
KNOWLEDGE_SEARCH_CANDIDATE_LIMIT=100
KNOWLEDGE_SEARCH_RRF_RANK_CONSTANT=30
KNOWLEDGE_QUERY_EXPANSION_ENABLED=true
KNOWLEDGE_QUERY_EXPANSION_LIMIT=2
KNOWLEDGE_RERANKING_ENABLED=false
KNOWLEDGE_RERANKING_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
KNOWLEDGE_RERANKING_MODEL_URI=https://huggingface.co/cross-encoder/mmarco-mMiniLMv2-L12-H384-v1/resolve/9b8bd7b40e70f84c2444fa0f6545773ad74c2fa6/onnx/model.onnx
KNOWLEDGE_RERANKING_TOKENIZER_URI=https://huggingface.co/cross-encoder/mmarco-mMiniLMv2-L12-H384-v1/resolve/9b8bd7b40e70f84c2444fa0f6545773ad74c2fa6/tokenizer.json
KNOWLEDGE_RERANKING_CACHE_DIRECTORY=data/models/spring-ai
KNOWLEDGE_RERANKING_CANDIDATE_LIMIT=100
KNOWLEDGE_RERANKING_RESULT_LIMIT=12
KNOWLEDGE_RERANKING_BATCH_SIZE=16
KNOWLEDGE_RERANKING_MAX_TOKENS=512
HUGGING_FACE_API_TOKEN=change_me

KNOWLEDGE_SEARCH_HEADING_WEIGHT=2

# PDF OCR fallback (images module, uses GEMINI_API_KEY)
DOCUMENT_OCR_ENABLED=true
DOCUMENT_OCR_MAX_PAGES=50
DOCUMENT_OCR_DPI=150
DOCUMENT_OCR_MAX_PIXELS=4000000
IMAGE_OCR_MODEL=gemini-2.5-flash
